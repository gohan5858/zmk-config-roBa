#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ARROW 1
#define SYMBOL 2
#define NUM 3
#define BT 4
#define SCROLL 5
#define MOUSE 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        td_lng1_lng2: td_lng1_lng2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LANG1>, <&kp LANG2>;
            label = "TD_LNG1_LNG2";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&mt LCTRL Q         &kp W         &kp E      &kp R      &kp T                                    &kp Y                   &kp U  &lt 0 I           &kp O    &kp P
&mt LEFT_COMMAND A  &kp S         &kp D      &kp F      &kp G  &kp LS(LG(S))      &kp MINUS      &kp H                   &kp J  &lt SCROLL K      &kp L    &kp ENTER
&mt LEFT_SHIFT Z    &kp X         &kp C      &kp V      &kp B  &kp COLON          &kp SEMICOLON  &kp N                   &kp M  &kp COMMA         &kp DOT  &mt LEFT_SHIFT SLASH
&mo 1               &kp LEFT_ALT  &kp LCTRL  &lt 2 TAB  &mo 3  &td_lng1_lng2      &kp BACKSPACE  &mt LEFT_COMMAND SPACE                                    &kp LEFT_ALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        ARROW {
            bindings = <
&trans  &trans  &trans  &trans     &trans                      &trans    &trans    &trans        &trans     &trans
&trans  &trans  &trans  &kp LCTRL  &trans  &trans      &trans  &kp LEFT  &kp DOWN  &kp UP_ARROW  &kp RIGHT  &trans
&trans  &trans  &trans  &trans     &trans  &trans      &trans  &trans    &trans    &trans        &trans     &trans
&trans  &trans  &trans  &trans     &trans  &trans      &trans  &trans                                       &trans
            >;
        };

        SYMBOL {
            bindings = <
&kp EXCL        &kp AT    &kp HASH   &kp DLLR   &kp PRCNT                              &kp ASTERISK  &kp AMPERSAND         &kp MINUS              &kp EQUAL  &kp RIGHT_PARENTHESIS
&kp CARET       &kp AMPS  &kp ASTRK  &kp LCTRL  &trans     &trans      &kp UNDERSCORE  &kp PIPE      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMI   &kp SQT
&kp LEFT_SHIFT  &trans    &trans     &trans     &trans     &trans      &trans          &kp GRAVE     &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans     &trans
&trans          &trans    &trans     &trans     &trans     &trans      &trans          &trans                                                                &trans
            >;
        };

        NUM {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &kp N7        &kp N8        &kp N9        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp N0                                            &trans
            >;
        };

        BT {
            bindings = <
&trans  &trans  &trans  &trans  &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &trans  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                              &trans
            >;
        };
    };
};
